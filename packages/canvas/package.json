{
  "name": "@awd/canvas",
  "version": "0.1.0",
  "description": "A shared canvas where an agent and a human align through diagrams — board store, templates, HTTP/WS server, MCP server.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./diagrams": {
      "types": "./dist/diagrams/index.d.ts",
      "import": "./dist/diagrams/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "awd-canvas": "dist/cli.js"
  },
  "files": [
    "dist",
    "web/dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "serve": "node dist/cli.js serve",
    "mcp": "node dist/cli.js mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "marked": "^17.0.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
