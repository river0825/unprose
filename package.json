{
  "name": "unprose",
  "private": true,
  "version": "0.1.0",
  "description": "Unprose — a shared visual canvas where people and AI agents talk designs through (EventStorming, story maps, kanban, wireframes, workflows), plus a small event-driven workflow runtime. A plugin for Claude Code, Codex and other MCP agents.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "packages/canvas/web"
  ],
  "scripts": {
    "build": "npm run build -w @awd/core && npm run build -w @awd/runtime && npm run build -w @awd/canvas && npm run build -w @awd/cli && npm run build -w @awd/canvas-web",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "start": "node scripts/start.mjs",
    "demo": "node packages/canvas/dist/cli.js demo && node packages/cli/bin/awd.js graph examples/card-pipeline/workflow.yaml --canvas"
  },
  "engines": {
    "node": ">=20"
  },
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
